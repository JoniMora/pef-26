# ─────────────────────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────────────────────
__pycache__/
.mypy_cache/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ─────────────────────────────────────────────────────────────
#  Entornos virtuales y variables de entorno
# ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version
.env
.env.local

# ─────────────────────────────────────────────────────────────
#  Corpus de documentos
#  Colección masiva: se genera con
#  `python3 src/baseline.py --generar`, no se versiona.
# ─────────────────────────────────────────────────────────────
data/*
!data/.gitkeep
!data/corpus/
data/corpus/*
!data/corpus/.gitkeep

# Archivos de corpus sueltos en cualquier ubicación
*.txt.gz
*.tar.gz
*.zip
/corpus/

# Red de seguridad: el corpus se genera en <repo>/data/corpus (ver
# DIRECTORIO_CORPUS_DEFAULT en src/baseline.py). Si igualmente se
# invoca el script desde src/ con una ruta relativa manual, esto evita
# que un corpus mal ubicado en src/data/ termine versionado.
/src/data/

# ─────────────────────────────────────────────────────────────
#  Índices serializados y caché en disco
#  Artefactos derivados del corpus: siempre reconstruibles.
# ─────────────────────────────────────────────────────────────
*.idx
*.index
*.pkl
*.pickle
index_cache/
.cache/

# ─────────────────────────────────────────────────────────────
#  Salidas de perfilado
#  Las salidas de los perfiladores se regeneran. Las cifras y las
#  capturas que se entregan están en docs/.
# ─────────────────────────────────────────────────────────────
profiles/*
!profiles/.gitkeep
*.prof
*.lprof
mprofile_*.dat
*.svg
!docs/diagramas/*.svg
*.speedscope.json

# ─────────────────────────────────────────────────────────────
#  New Relic
#  Se versiona solo la plantilla (newrelic.ini.example), no la copia
#  local. El log del agente ya lo cubre la regla *.log.
# ─────────────────────────────────────────────────────────────
newrelic.ini

# ─────────────────────────────────────────────────────────────
#  Testing y análisis estático
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ─────────────────────────────────────────────────────────────
#  Logs
# ─────────────────────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────────────────────
#  Editores e IDEs
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────
#  Sistema operativo
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
#  Jupyter (notebooks de análisis de métricas)
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────
#  Presentación
#  El guion del orador es de uso personal: no se versiona.
# ─────────────────────────────────────────────────────────────
presentacion/guion-orador.txt

# ─────────────────────────────────────────────────────────────
#  Documentación generada
#  docs/_build se reconstruye con sphinx-build.
# ─────────────────────────────────────────────────────────────
docs/_build/

# ─────────────────────────────────────────────────────────────
#  Herramientas y reportes de los controles
#  Se regeneran con make (ver docs/mantenimiento.md).
# ─────────────────────────────────────────────────────────────
node_modules/
.herramientas/
reportes/
