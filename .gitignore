# ─────────────────────────────────────────────────────────────
#  Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ─────────────────────────────────────────────────────────────
#  Entornos virtuales y variables de entorno
# ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version
.env
.env.local

# ─────────────────────────────────────────────────────────────
#  Corpus de documentos
#  Colección masiva (>= 1 GB): se descarga con
#  `python -m src.tools.fetch_corpus`, no se versiona.
# ─────────────────────────────────────────────────────────────
data/*
!data/.gitkeep
!data/corpus/
data/corpus/*
!data/corpus/.gitkeep

# Archivos de corpus sueltos en cualquier ubicación
*.txt.gz
*.tar.gz
*.zip
/corpus/

# Red de seguridad: el corpus se genera en <repo>/data/corpus (ver
# DIRECTORIO_CORPUS_DEFAULT en src/baseline.py). Si igualmente se
# invoca el script desde src/ con una ruta relativa manual, esto evita
# que un corpus mal ubicado en src/data/ termine versionado.
/src/data/

# ─────────────────────────────────────────────────────────────
#  Índices serializados y caché en disco
#  Artefactos derivados del corpus: siempre reconstruibles.
# ─────────────────────────────────────────────────────────────
*.idx
*.index
*.pkl
*.pickle
index_cache/
.cache/

# ─────────────────────────────────────────────────────────────
#  Salidas de perfilado
#  Los binarios de profiling se ignoran; la tabla de resultados
#  (benchmarks/results.md) SÍ se versiona: es la evidencia
#  entregable de la mejora de rendimiento.
# ─────────────────────────────────────────────────────────────
profiles/*
!profiles/.gitkeep
*.prof
*.lprof
mprofile_*.dat
*.svg
*.speedscope.json

# ─────────────────────────────────────────────────────────────
#  Testing y análisis estático
# ─────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ─────────────────────────────────────────────────────────────
#  Logs
# ─────────────────────────────────────────────────────────────
*.log
logs/

# ─────────────────────────────────────────────────────────────
#  Editores e IDEs
# ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────
#  Sistema operativo
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
#  Jupyter (notebooks de análisis de métricas)
# ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/
